# TerraQuest AI — Environment Configuration
# Touch Grass, Not Screens 🌿

# Base URL for local Ollama server (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Default open-weight instruction model (e.g. qwen2.5:3b, gemma2:2b, llama3.2:3b)
DEFAULT_AI_MODEL=qwen2.5:3b

# Default vision model for multimodal plant/bird classification (e.g. moondream, llava:7b)
DEFAULT_VISION_MODEL=moondream

# Optional custom OpenAI-compatible local endpoint (e.g., LM Studio: http://localhost:1234/v1)
# CUSTOM_LOCAL_AI_URL=http://localhost:1234/v1
# CUSTOM_LOCAL_AI_KEY=optional_key

# Set to 1 to enable Next.js API telemetry opt-out
NEXT_TELEMETRY_DISABLED=1
